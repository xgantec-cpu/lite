DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DJANGO_USE_SQLITE=0
DJANGO_SQLITE_PATH=db.sqlite3
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_TRUST_PROXY_HEADERS=1
DJANGO_SECURE_COOKIES=1
DJANGO_ADMIN_SECTION_PASSWORD=replace-with-a-strong-admin-password
DJANGO_CASE_DELETE_PASSWORD=replace-with-a-separate-delete-password
WEBPUSH_VAPID_PUBLIC_KEY=replace-with-base64url-public-key
WEBPUSH_VAPID_PRIVATE_KEY=replace-with-private-key-or-pem-path
WEBPUSH_VAPID_SUBJECT=mailto:alerts@example.com
# Enable Google Routes API traffic-aware routing after restricting this server key.
GOOGLE_MAPS_API_KEY=replace-with-google-maps-platform-server-key
# Add a short-lived TURN credential for calls across mobile networks.
RTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
