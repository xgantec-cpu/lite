DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DJANGO_USE_SQLITE=0
DJANGO_SQLITE_PATH=db.sqlite3
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_COOKIES=1
DJANGO_ADMIN_SECTION_PASSWORD=replace-with-a-strong-admin-password
DJANGO_CASE_DELETE_PASSWORD=replace-with-a-separate-delete-password
